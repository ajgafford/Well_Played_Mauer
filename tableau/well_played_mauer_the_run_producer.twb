        <calculation class='tableau' formula='IF LEN([Team]) &gt; 3 THEN&#10;    LEFT([Team], 3) + &quot;/&quot; + MID([Team], 4, LEN([Team]) - 3)&#10;ELSE&#10;    [Team]&#10;END' />
